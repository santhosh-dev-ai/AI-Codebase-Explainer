# AI Provider: 'groq' or 'openai'
AI_PROVIDER=groq

# AI Model Configuration (defaults to active Groq models: openai/gpt-oss-120b and qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
OPENAI_MODEL=gpt-4-turbo-preview

# Use GROQ_API_KEY for Groq or OPENAI_API_KEY for OpenAI
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=

GITHUB_TOKEN=
PORT=3001
NODE_ENV=development
REDIS_URL=
MAX_FILE_SIZE=52428800
SESSION_TTL=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
